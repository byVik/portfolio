{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // A Worker with no code: it only serves the static files in dist/.
  "name": "viktorstrohush-portfolio",
  "compatibility_date": "2026-10-09",
  "assets": {
    "directory": "./dist",
  },
  "routes": [
    { "pattern": "viktorstrohush.dev", "custom_domain": true },
    { "pattern": "www.viktorstrohush.dev", "custom_domain": true },
  ],
  // The portfolio is only served from its own domain: no indexable copies on workers.dev.
  "workers_dev": false,
  "preview_urls": false,
}
